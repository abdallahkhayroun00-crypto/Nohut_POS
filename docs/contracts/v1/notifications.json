{
  "schemaVersion": 1,
  "spec": "NOHUT POS 2.0 Master Specification V5.1 §23.5",
  "status": "PROPOSED_V5 — Windows history + LAN feed implemented; cloud transport pending (N3, #39)",
  "authority": "Notifications are never confirmation of an order or payment. Clients always fetch committed state from the Windows POS.",
  "event": {
    "required": [
      "eventId",
      "category",
      "severity",
      "createdAt",
      "title"
    ],
    "fields": {
      "eventId": "stable, unique deduplication key: '<source>:<entity key>[:<transition>]'",
      "category": "one of categories[].id",
      "severity": "low | normal | high",
      "createdAt": "ISO-8601 UTC",
      "title": "short text, safe for a lock screen",
      "body": "optional detail; never payroll amounts, customer names, phone numbers or addresses",
      "ref": "{kind, key} of the source entity (order, packageId, review, printJob, terminalAttempt, user)",
      "permission": "operation id a recipient must hold (null = every signed-in user of the listed clients)",
      "read": "per-recipient read state (Windows: global for the POS operator)",
      "windows": "Windows popup state: pending | shown | dismissed | later"
    }
  },
  "lockScreen": "title only; body is shown only inside the unlocked app",
  "severities": [
    "low",
    "normal",
    "high"
  ],
  "categories": [
    {
      "id": "order.table",
      "label": "Yeni masa siparişi",
      "severity": "normal",
      "permission": "tables.view",
      "clients": [
